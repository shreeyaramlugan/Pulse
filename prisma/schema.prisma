generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  EMAIL
}

enum WeekStart {
  SUNDAY
  MONDAY
}

enum NotificationPreference {
  ALL
  IMPORTANT
  NONE
}

enum Theme {
  organic
  chai
  cyberpunk
  futuristic
  obsidian
  pink
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  TELEGRAM
  PUSH
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
  ARCHIVED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalProgressType {
  MANUAL
  METRIC
  SUBGOALS
}

enum GoalMetricType {
  NUMBER
  CURRENCY
  PERCENTAGE
  HOURS
  MINUTES
  CUSTOM
}

enum GoalMetricDirection {
  INCREASE
  DECREASE
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String
  avatarUrl String?

  timezone               String  @default("Africa/Johannesburg")
  weekStartsOn           Int     @default(1)
  notificationPreference String  @default("ALL")
  theme                  String  @default("organic")
  onboardingComplete     Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  currency   String   @default("ZAR")
  dateFormat String   @default("DD/MM/YYYY")
  timeFormat String   @default("24H")
  language   String   @default("en")

  authAccounts AuthAccount[]

  tasks         Task[]
  projects      Project[]
  goals         Goal[]
  reminders     Reminder[]
  notifications Notification[]
}

model AuthAccount {
  id         String       @id @default(uuid())
  userId     String
  provider   AuthProvider
  email      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  externalId String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
}

model Task {
  id String @id @default(uuid())

  userId       String
  projectId    String?
  parentTaskId String?
  goalId       String?

  title       String
  description String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  dueDate DateTime?

  estimatedMinutes Int?
  actualMinutes    Int?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal    Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  parentTask Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks   Task[] @relation("TaskSubtasks")

  recurrence TaskRecurrence?
  reminders  Reminder[]

  @@index([userId])
  @@index([projectId])
  @@index([goalId])
  @@index([parentTaskId])
  @@index([status])
  @@index([dueDate])
  @@index([userId, status])
  @@index([userId, dueDate])
}

model TaskRecurrence {
  id String @id @default(uuid())

  taskId String @unique
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  frequency RecurrenceFrequency
  interval  Int                 @default(1)

  daysOfWeek Int[]

  startDate DateTime
  endDate   DateTime?

  nextRunAt DateTime?

  lastRunAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(uuid())

  userId   String
  clientId String?

  name        String
  description String?

  status   ProjectStatus   @default(PLANNING)
  priority ProjectPriority @default(MEDIUM)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tasks Task[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([userId, status])
}

model Reminder {
  id String @id @default(uuid())

  userId String

  taskId  String?
  eventId String?
  habitId String?

  title    String
  remindAt DateTime

  status ReminderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Add these when Event/Habit models exist
  // event       Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // habit       Habit?          @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([remindAt])
  @@index([status])
  @@index([userId, remindAt])
}

model Notification {
  id String @id @default(uuid())

  userId String

  type String

  title   String
  message String

  priority NotificationPriority @default(NORMAL)
  channel  NotificationChannel  @default(IN_APP)

  scheduledFor DateTime?
  sentAt       DateTime?
  readAt       DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([userId, scheduledFor])
  @@index([scheduledFor])
  @@index([sentAt])
}

model Goal {
  id String @id @default(uuid())

  userId String

  // Goal hierarchy
  parentGoalId String?

  title       String
  description String?

  // Time classification
  period GoalPeriod @default(MONTHLY)

  // Lifecycle
  status   GoalStatus   @default(ACTIVE)
  priority GoalPriority @default(MEDIUM)

  // Progress
  progressType GoalProgressType @default(MANUAL)

  // Metric configuration
  metricType      GoalMetricType?
  metricName      String?
  unit            String?
  metricDirection GoalMetricDirection @default(INCREASE)

  startValue   Decimal? @db.Decimal(14, 2)
  currentValue Decimal? @db.Decimal(14, 2)
  targetValue  Decimal? @db.Decimal(14, 2)

  // Dates
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentGoal Goal? @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)

  subGoals Goal[] @relation("GoalHierarchy")

  tasks Task[]

  progressEntries GoalProgressEntry[]

  @@index([userId])
  @@index([userId, period])
  @@index([userId, status])
  @@index([userId, targetDate])
  @@index([parentGoalId])
}

model GoalProgressEntry {
  id String @id @default(uuid())

  goalId String

  value Decimal @db.Decimal(14, 2)

  note String?

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([goalId, recordedAt])
}
