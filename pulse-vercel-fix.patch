+  description: string | null;
+  status:
+    | "ACTIVE"
+    | "COMPLETED"
+    | "PAUSED"
+    | "CANCELLED"
+    | "ARCHIVED";
+  priority: "LOW" | "MEDIUM" | "HIGH" | "URGENT";
+  targetDate: string | null;
+  parentGoalId?: string | null;
+};
+
+export type Goal = {
+id: string;
+title: string;
+description: string | null;
+
+parentGoalId: string | null;
+
+period:
+| "DAILY"
+| "WEEKLY"
+| "MONTHLY"
+| "QUARTERLY"
+| "ANNUAL";
+
+status:
+| "ACTIVE"
+| "COMPLETED"
+| "PAUSED"
